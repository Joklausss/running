{
  "name": "running-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personalized running app: AI training plans, geolocated routes, GPS tracking & stats.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:lan": "node scripts/lan-url.mjs & npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "migrate": "npm run migrate --workspace backend",
    "lint": "eslint backend/src frontend/src",
    "e2e": "playwright test",
    "test": "tsx frontend/src/pages/stats/statsMath.test.ts && tsx frontend/src/pages/plan/workout.test.ts && tsx frontend/src/pages/track/trackingMath.test.ts && tsx backend/src/services/TrainingPlanService.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.61.0"
  }
}
